/>\n            </defs>\n            <circle cx=\"100\" cy=\"100\" r=\"88\" stroke=\"currentColor\" stroke-width=\"0.8\"/>\n            <circle cx=\"100\" cy=\"100\" r=\"82\" stroke=\"currentColor\" stroke-width=\"0.45\" stroke-dasharray=\"1 4\"/>\n            <text fill=\"currentColor\" font-family=\"JetBrains Mono, monospace\" font-size=\"8.6\" letter-spacing=\"1.2\">\n              <textPath href=\"#sealArc\" startOffset=\"0%\" textLength=\"456\" lengthAdjust=\"spacing\">FOLD · PRIVATE BY DEFAULT · LOCAL FIRST · NO CLOUD · NO ACCOUNT · </textPath>\n            </text>\n            <g transform=\"translate(82 78) scale(1.5)\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linejoin=\"round\" stroke-linecap=\"round\">\n              <path d=\"M5.75 3.25h8l5 5v12.5h-13z\"/>\n              <path d=\"M13.75 3.25v5h5\"/>\n              <path d=\"M8.75 12h5.5M8.75 15.5h3.5\"/>\n            </g>\n            <text x=\"100\" y=\"130\" fill=\"currentColor\" text-anchor=\"middle\" font-family=\"JetBrains Mono, monospace\" font-size=\"5.6\" letter-spacing=\"1.8\">FOLD 2.0</text>\n          </svg>\n        </div>\n\n        <div class=\"hero-pointer-light\"></div>\n        <div class=\"hero-atmosphere__vignette\"></div>\n      </div>\n\n      <!-- Editorial Margin Annotations -->\n      <div class=\"hero-margin-note hero-margin-note--left\" aria-hidden=\"true\">\n        <span class=\"hero-margin-note__rule\"></span>\n        <span>Local-first<br>by design</span>\n      </div>\n      <div class=\"hero-margin-note hero-margin-note--right\" aria-hidden=\"true\">\n        <span>No cloud<br>No account</span>\n        <span class=\"hero-margin-note__rule\"></span>\n      </div>\n\n      <!-- Loose paper fragments, resting at the edge of the sheet -->\n      <div class=\"hero-paper-note hero-paper-note--left\" aria-hidden=\"true\">\n        <span class=\"hero-paper-note__meta\">Journal · 14:02</span>\n        <p>the quiet part<br>is the point.</p>\n      </div>\n      <div class=\"hero-paper-note hero-paper-note--right\" aria-hidden=\"true\">\n        <span class=\"hero-paper-note__meta\">Inbox</span>\n        <p>Renewal window<br>opens 1 June.</p>\n      </div>",
  "heroContentIntro": "<!-- Eyebrow Pill Badge -->\n        <div class=\"hero-eyebrow-pill\">\n          <span class=\"hero-eyebrow-pill__badge\">Fold 2.0</span>\n          <span>Mac Craft Workspace · IndexedDB Engine</span>\n          <span aria-hidden=\"true\">↗</span>\n        </div>\n\n        <!-- Display Heading -->\n        <h1 class=\"hero-display-heading\" id=\"heroTitle\">\n          Notes, <span class=\"hero-gradient-text\">without the noise.</span>\n        </h1>\n\n        <!-- Subtitle -->\n        <p class=\"hero-lede-text\">\n          A calm, private place for every thought you mean to keep. Zero accounts, zero cloud dependencies, and zero tracking — powered by local IndexedDB and engineered with tactile physical craft.\n        </p>\n\n        <!-- Tactile Dual CTAs -->\n        <div class=\"hero-cta-cluster\">\n          <a class=\"btn-primary-tactile\" href=\"/app\">\n            <span>Start writing in Fold</span>\n            <span class=\"btn-arrow\" aria-hidden=\"true\">→</span>\n          </a>\n          <a class=\"btn-ghost-tactile\" href=\"#app\">\n            <span class=\"live-pulse-dot\" aria-hidden=\"true\"></span>\n            <span>Try live demo below</span>\n          </a>\n        </div>\n\n        <!-- Craft Proof Badges -->\n        <div class=\"hero-badges-row\">\n          <span class=\"hero-badge-item\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"m3.5 8.5 3 3 6-6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            <span>IndexedDB Engine</span>\n          </span>\n          <span class=\"hero-badge-item\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"m3.5 8.5 3 3 6-6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            <span>100% Offline PWA</span>\n          </span>\n          <span class=\"hero-badge-item\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"m3.5 8.5 3 3 6-6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            <span>Zero Lock-in</span>\n          </span>\n        </div>\n\n        <!-- Embedded Interactive Live Demo Showcase -->",
  "bento": "<!-- Section 3: Bento Grid Layout (\"Why Fold\") -->\n    <section class=\"section-bento\" id=\"features\" aria-labelledby=\"featuresTitle\">\n      <div class=\"shell\">\n        <header class=\"section-header-centered\">\n          <div class=\"eyebrow-craft\"><span class=\"eyebrow-craft__tag\">01</span> Why Fold</div>\n          <h2 class=\"section-title-craft\" id=\"featuresTitle\">\n            Everything your mind needs.<br><span class=\"hero-gradient-text\">Nothing it doesn’t.</span>\n          </h2>\n          <p class=\"section-subtitle-craft\">\n            Most notes applications demand your attention with feeds, subscriptions, and sync spinners. Fold offers a single quiet page that simply works.\n          </p>\n        </header>\n\n        <!-- Bento Grid -->\n        <div class=\"bento-grid\">\n          <!-- Tile 1: Tall Feature Card (Row Span 2 on desktop) -->\n          <div class=\"bento-card bento-card--tall\">\n            <div class=\"bento-card-inner\">\n              <div class=\"specular-line\" aria-hidden=\"true\"></div>\n              <div>\n                <div class=\"craft-icon-tile\">\n                  <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n                </div>\n                <span class=\"bento-category\">Foundations</span>\n                <h3 class=\"bento-title\">Zero Tracking, 100% On-Device</h3>\n                <p class=\"bento-desc\">\n                  Your notes never leave this machine. No telemetry on keystrokes, no LLM training crawlers, and no cloud servers intercepting your thoughts.\n                </p>\n              </div>\n\n              <!-- Doblique-style Telemetry Module -->\n              <div class=\"telemetry-box\">\n                <div class=\"telemetry-row\">\n                  <span>Storage Engine</span>\n                  <strong class=\"text-accent\">IndexedDB Local</strong>\n                </div>\n                <div class=\"telemetry-row\">\n                  <span>Server Connections</span>\n                  <strong>0</strong>\n                </div>\n                <div class=\"telemetry-row\">\n                  <span>Accounts Required</span>\n                  <strong>None</strong>\n                </div>\n              </div>\n\n              <a class=\"bento-action-row\" href=\"#questions\">\n                <span>Learn privacy principles</span>\n                <span class=\"bento-arrow\" aria-hidden=\"true\">→</span>\n              </a>\n            </div>\n          </div>\n\n          <!-- Tile 2: Wide Card (Col Span 2) -->\n          <div class=\"bento-card bento-card--wide\">\n            <div class=\"bento-card-inner\">\n              <div class=\"specular-line\" aria-hidden=\"true\"></div>\n              <div>\n                <div class=\"craft-icon-tile\">\n                  <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"11\" cy=\"11\" r=\"7\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"m20 20-3.5-3.5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg>\n                </div>\n                <span class=\"bento-category\">Speed</span>\n                <h3 class=\"bento-title\">Search Every Memory as You Type</h3>\n                <p class=\"bento-desc\">\n                  Instant sub-millisecond full-text queries across all titles, paragraphs, and checklists with dynamic &lt;mark&gt; substring highlighting.\n                </p>\n              </div>\n\n              <!-- Interactive Command Simulation -->\n              <div class=\"cmd-preview-box\">\n                <div class=\"cmd-input-row\">\n                  <svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"none\"><circle cx=\"7\" cy=\"7\" r=\"4\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"m10 10 3 3\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n                  <span>lease renewal</span>\n                  <span class=\"cmd-caret\"></span>\n                </div>\n                <div class=\"cmd-result-chip\">\n                  <strong>Studio <mark class=\"search-match\">lease renewal</mark>, 2026</strong>\n                  <span>Renewal window opens 1 June…</span>\n                </div>\n              </div>\n\n              <a class=\"bento-action-row\" href=\"#app\">\n                <span>Explore search mechanics</span>\n                <span class=\"bento-arrow\" aria-hidden=\"true\">→</span>\n              </a>\n            </div>\n          </div>\n\n          <!-- Tile 3: Standard Bento Tile -->\n          <div class=\"bento-card\">\n            <div class=\"bento-card-inner\">\n              <div class=\"specular-line\" aria-hidden=\"true\"></div>\n              <div>\n                <div class=\"craft-icon-tile\">\n                  <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 7v10c0 2 4 3 8 3s8-1 8-3V7M4 7c0 2 4 3 8 3s8-1 8-3M4 7c0-2 4-3 8-3s8 1 8 3M4 12c0 2 4 3 8 3s8-1 8-3\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg>\n                </div>\n                <h3 class=\"bento-title\">IndexedDB Power</h3>\n                <p class=\"bento-desc\">\n                  Replaces the legacy 5MB localStorage cap. Non-blocking asynchronous writes that scale to thousands of notes effortlessly.\n                </p>\n              </div>\n              <a class=\"bento-action-row\" href=\"#writing\">\n                <span>Storage engine</span>\n                <span class=\"bento-arrow\" aria-hidden=\"true\">→</span>\n              </a>\n            </div>\n          </div>\n\n          <!-- Tile 4: Standard Bento Tile -->\n          <div class=\"bento-card\">\n            <div class=\"bento-card-inner\">\n              <div class=\"specular-line\" aria-hidden=\"true\"></div>\n              <div>\n                <div class=\"craft-icon-tile\">\n                  <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/><path d=\"M14 2v6h6M16 13H8M16 17H8M10 9H8\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg>\n                </div>\n                <h3 class=\"bento-title\">Markdown In & Out</h3>\n                <p class=\"bento-desc\">\n                  Drag and drop any .md file to import. One-click copy or download clean Markdown anytime so your writing outlives the app.\n                </p>\n              </div>\n              <a class=\"bento-action-row\" href=\"#questions\">\n                <span>Portable text</span>\n                <span class=\"bento-arrow\" aria-hidden=\"true\">→</span>\n              </a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>",
  "encapsulated": "<!-- Section 4: Encapsulated Feature Chassis (\"Reasons you will love Fold\") -->\n    <section class=\"section-encapsulated\" id=\"writing\" aria-labelledby=\"writingTitle\">\n      <div class=\"shell\">\n        <div class=\"chassis-outer\">\n          <div class=\"chassis-inner\">\n            <div class=\"specular-line\" aria-hidden=\"true\"></div>\n\n            <div class=\"chassis-head\">\n              <div class=\"eyebrow-craft\"><span class=\"eyebrow-craft__tag\">02</span> The Craft</div>\n              <h2 class=\"chassis-title\" id=\"writingTitle\">\n                Reasons you will <span class=\"hero-gradient-text\">love writing here.</span>\n              </h2>\n              <p class=\"chassis-subtitle\">\n                Once you feel the responsiveness of a zero-noise local workspace, you'll never return to bloated note suites.\n              </p>\n            </div>\n\n            <!-- 6-Item Feature Grid -->\n            <div class=\"chassis-grid\">\n              <div class=\"chassis-item\">\n                <div class=\"craft-icon-tile craft-icon-tile--small\">\n                  <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M8 2v12M2 8h12\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>\n                </div>\n                <h4>Tactile Keybindings</h4>\n                <p>Format with ⌘B, ⌘I, ⌘⌥2, ⌘⇧8, and ⌘⇧9 without taking your hands off the keyboard.</p>\n              </div>\n              <div class=\"chassis-item\">\n                <div class=\"craft-icon-tile craft-icon-tile--small\">\n                  <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M9.5 2.5 13.5 6.5M10.5 4.5l-2 2-3.5-.5-2.5 2.5 4 4 2.5-2.5-.5-3.5 2-2M4.5 11.5 2 14\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n                </div>\n                <h4>Pinned Notes</h4>\n                <p>Pin essential notes and templates to the top so they stay anchored above date sorts.</p>\n              </div>\n              <div class=\"chassis-item\">\n                <div class=\"craft-icon-tile craft-icon-tile--small\">\n                  <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" fill=\"none\"><circle cx=\"8\" cy=\"8\" r=\"6\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M8 4v4l2.5 2.5\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n                </div>\n                <h4>Live Reading Time</h4>\n                <p>Dynamic \"~X min read\" telemetry calculated alongside word count as you compose.</p>\n              </div>\n              <div class=\"chassis-item\">\n                <div class=\"craft-icon-tile craft-icon-tile--small\">\n                  <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" fill=\"none\"><rect x=\"2.5\" y=\"4.5\" width=\"11\" height=\"8\" rx=\"1.5\" stroke=\"currentColor\" stroke-width=\"1.3\"/><path d=\"m6 4.5 2-2 2 2\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n                </div>\n                <h4>Offline Service Worker</h4>\n                <p>Pre-cached typography and app shell so you can write in cabins, planes, and subways.</p>\n              </div>\n              <div class=\"chassis-item\">\n                <div class=\"craft-icon-tile craft-icon-tile--small\">\n                  <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M2.5 4.5h11M5.5 8h5M7 11.5h2\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n                </div>\n                <h4>Smart Sort Orders</h4>\n                <p>Toggle between Newest first, Oldest, Alphabetical A–Z, or Starred priorities in one tap.</p>\n              </div>\n              <div class=\"chassis-item\">\n                <div class=\"craft-icon-tile craft-icon-tile--small\">\n                  <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 12V4h8v8\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linejoin=\"round\"/><path d=\"M7 7h2M7 9h2\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\"/></svg>\n                </div>\n                <h4>Multi-Tab Sync</h4>\n                <p>BroadcastChannel keeps open windows in perfect sync without page reloads or conflicts.</p>\n              </div>\n            </div>\n\n            <!-- Anchored Bottom CTA -->\n            <div class=\"chassis-cta-anchor\">\n              <a class=\"btn-primary-tactile\" href=\"/app\">\n                <span>Open Fold Workspace ↗</span>\n              </a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>",
  "faq": "<!-- Section 5: Micro-Beveled FAQ Grid -->\n    <section class=\"section-faq\" id=\"questions\" aria-labelledby=\"faqTitle\">\n      <div class=\"shell\">\n        <header class=\"section-header-centered\">\n          <div class=\"eyebrow-craft\"><span class=\"eyebrow-craft__tag\">03</span> FAQ</div>\n          <h2 class=\"section-title-craft\" id=\"faqTitle\">\n            Frequently Asked <span class=\"hero-gradient-text\">Questions</span>\n          </h2>\n          <p class=\"section-subtitle-craft\">Honest, straight answers to how Fold operates.</p>\n        </header>\n\n        <div class=\"faq-craft-grid\">\n          <div class=\"faq-card\">\n            <div class=\"craft-icon-tile craft-icon-tile--small\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"/><path d=\"M21 12c0 1.66-4 3-9 3s-9-1.34-9-3\"/><path d=\"M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5\"/></svg></div>\n            <div>\n              <h3 class=\"faq-question\">Where are my notes stored?</h3>\n              <p class=\"faq-answer\">Directly in your browser's IndexedDB storage. Fold operates 100% locally on your machine. Nothing is transmitted over the wire to any server.</p>\n            </div>\n          </div>\n\n          <div class=\"faq-card\">\n            <div class=\"craft-icon-tile craft-icon-tile--small\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"/></svg></div>\n            <div>\n              <h3 class=\"faq-question\">Is Fold completely free?</h3>\n              <p class=\"faq-answer\">Yes, 100% free with no paywalls, subscriptions, or feature locks. The entire app is client-side and requires zero cloud infrastructure to maintain.</p>\n            </div>\n          </div>\n\n          <div class=\"faq-card\">\n            <div class=\"craft-icon-tile craft-icon-tile--small\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M1 1l22 22\"/><path d=\"M16.72 11.06A10.94 10.94 0 0 1 19 12.55\"/><path d=\"M5 12.55a10.94 10.94 0 0 1 5.17-2.39\"/><path d=\"M10.71 5.05A16 16 0 0 1 22.56 9.5\"/><path d=\"M1.42 9.5a15.91 15.91 0 0 1 4.7-2.88\"/><path d=\"M8.53 16.11a6 6 0 0 1 6.95 0\"/><line x1=\"12\" y1=\"20\" x2=\"12.01\" y2=\"20\"/></svg></div>\n            <div>\n              <h3 class=\"faq-question\">Does it work offline?</h3>\n              <p class=\"faq-answer\">Yes. Fold installs as a Progressive Web App (PWA) with a dedicated Service Worker caching the font typography and app shell for seamless offline usage.</p>\n            </div>\n          </div>\n\n          <div class=\"faq-card\">\n            <div class=\"craft-icon-tile craft-icon-tile--small\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"7 10 12 15 17 10\"/><line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"/></svg></div>\n            <div>\n              <h3 class=\"faq-question\">Can I export my notes?</h3>\n              <p class=\"faq-answer\">Yes. With one click you can export everything as Markdown or JSON, or copy individual notes as Markdown to paste anywhere.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>",
  "cta": "<!-- Section 6: Launch CTA Banner -->\n    <section class=\"section-cta\" id=\"privacy\">\n      <div class=\"shell\">\n        <div class=\"cta-craft-panel\">\n          <div class=\"specular-line\" aria-hidden=\"true\"></div>\n          <div class=\"cta-craft-content\">\n            <h2 class=\"cta-craft-title\">Ready for notes <br><span class=\"hero-gradient-text\">without the noise?</span></h2>\n            <p class=\"cta-craft-desc\">No signup, no tracking. Open the standalone workspace and start writing immediately.</p>\n            <a class=\"btn-primary-tactile btn-primary-tactile--large\" href=\"/app\">\n              <span>Launch Fold App</span>\n              <span class=\"btn-arrow\" aria-hidden=\"true\">→</span>\n            </a>\n            <p class=\"cta-craft-footnote\">Free & private forever · Data stays on your device</p>\n          </div>\n        </div>\n      </div>\n    </section>",
  "footer": "<footer class=\"site-footer\">\n    <div class=\"shell footer-inner\">\n      <div class=\"footer-brand\">\n        <span class=\"nav-brand__name\">fold<span class=\"nav-brand__dot\">.</span></span>\n        <p>A quiet, hardware-grade field workspace for the web. Made for the thoughts you mean to keep.</p>\n      </div>\n      <div class=\"footer-legal\">\n        <span>&copy; 2026 Fold · 100% On-Device · IndexedDB</span>\n      </div>\n    </div>\n  </footer>"
}